*.tsbuildinfo
next-env.d.ts

# email build outputs (npm run email:zip / email:preview)
/emails/*.zip
/emails/*/preview*.html

# Conductor workspace scratch (screenshots, Lighthouse reports, one-off QA scripts) — local only
/.context/
