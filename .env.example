# Names only. Real values live in Vercel → Project → Settings → Environment Variables.
# Never commit values, never prefix a secret with NEXT_PUBLIC_.

# public (inlined at build — changing one needs a redeploy)
NEXT_PUBLIC_WAITLIST=true
NEXT_PUBLIC_TALLY_FORM_ID=

# server-only
SITE_URL=http://localhost:3000
LOOPS_API_KEY=
LOOPS_TRANSACTIONAL_ID=
LOOPS_LAUNCH_LIST_ID=
DOWNLOAD_SIGNING_SECRET=

# Vercel → Firewall: add ONE "@vercel/firewall" rule (Hobby allows one) with rate-limit ID:
#   download   — per IP, shared by POST /api/download and POST /api/waitlist
# Previews sign download links for their own branch URL (VERCEL_BRANCH_URL, a system variable).
